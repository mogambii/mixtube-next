generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  email              String    @unique
  username           String?   @unique
  password           String?
  name               String?
  type               String    @default("user")
  bio                String?
  djName             String?
  profilep     String?   @default("https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png")
  contacts           Json?
  socialMediaHandles Json?
  followers          String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  emailVerified      DateTime?
  image              String?

  accounts      Account[]
  sessions      Session[]
  mixtapes      Mixtape[]
  comments      Comment[]
  following     Follower[]     @relation("Following")
  followedBy    Follower[]     @relation("FollowedBy")
  likedMixtapes MixtapeLike[]
  notifications     Notification[] @relation("UserNotifications")
  notificationsSent Notification[] @relation("NotificationSender")

  @@map("users")
}

model Follower {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId  String   @db.ObjectId
  followingId String   @db.ObjectId
  createdAt   DateTime @default(now())

  follower  User @relation(fields: [followerId], references: [id], onDelete: Cascade, name: "Following")
  following User @relation(fields: [followingId], references: [id], onDelete: Cascade, name: "FollowedBy")

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?  @db.ObjectId
  mixtapeId String   @db.ObjectId

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  mixtape Mixtape @relation(fields: [mixtapeId], references: [id], onDelete: Cascade)

  @@index([mixtapeId])
  @@index([userId])
}

model Mixtape {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  desc        String?   @default("")
  genre       String    @default("Unknown")
  imgthumb    String?   @default("")
  audio       String
  downloadUrl String?   @default("")
  time        DateTime  @default(now())
  unique      String    @unique
  compressed  Boolean   @default(false)
  compressedUrl String?   @default("")
  djName      String    @default("Unknown DJ")
  userId      String    @db.ObjectId

  comments      Comment[]
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats        Stats[]
  mixtapeLikes MixtapeLike[]
  totalPlays   Int       @default(0)
  totalDownloads Int     @default(0)
  totalLikes   Int       @default(0)
  
  notifications Notification[]

  @@index([userId])
  @@index([genre])
}

model MixtapeLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  mixtapeId String   @db.ObjectId
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mixtape Mixtape @relation(fields: [mixtapeId], references: [id], onDelete: Cascade)

  @@unique([userId, mixtapeId])
  @@index([userId])
  @@index([mixtapeId])
}

model Stats {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  mixtapeId String   @db.ObjectId
  plays     Int      @default(0)
  downloads Int      @default(0)
  shares    Int      @default(0)
  date      DateTime @default(now())

  mixtape Mixtape @relation(fields: [mixtapeId], references: [id], onDelete: Cascade)

  @@unique([mixtapeId, date])
  @@index([mixtapeId])
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // e.g., "FOLLOW", "LIKE", "COMMENT"
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  userId      String   @db.ObjectId
  senderId    String   @db.ObjectId
  mixtapeId   String?  @db.ObjectId

  user     User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender   User     @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  mixtape  Mixtape? @relation(fields: [mixtapeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([senderId])
  @@index([mixtapeId])
}

model ResetToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}